	(text_box "Output Voltage given by:\nVout = 0.6V *(1 + R1/R2)\n5V = 0.6V * (1 + R1/10k)\nR1 = (5V - 0.6V)*10k = 44k"
		(exclude_from_sim no)
		(at 57.15 24.13 0)
		(size 36.83 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
